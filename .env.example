# Keystatic GitHub mode (required for production / Vercel)
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the callback URL to: https://your-domain.com/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret used to sign Keystatic session tokens (generate with: openssl rand -hex 32)
KEYSTATIC_SECRET=

# Password for the /keystatic Basic Auth gate (omit in local dev to skip auth)
KEYSTATIC_AUTH_PASSWORD=

# Upstash Redis (rate limiting + whisper dedup)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Whisper anti-abuse
WHISPER_TOKEN_SECRET=
# Separate private R2 bucket for whisper messages (falls back to R2_BUCKET_NAME if unset)
WHISPER_BUCKET_NAME=

# Google Analytics (optional — omit to disable GA)
NEXT_PUBLIC_GA_ID=

# Vercel deployment (used by CI)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
