# Keystatic GitHub mode (required for production / Vercel)
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the callback URL to: https://your-domain.com/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret used to sign Keystatic session tokens (generate with: openssl rand -hex 32)
KEYSTATIC_SECRET=

# Vercel deployment (used by CI)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
