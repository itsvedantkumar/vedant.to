# Keystatic GitHub mode (required for production / Vercel)
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the callback URL to: https://your-domain.com/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret used to sign Keystatic session tokens (generate with: openssl rand -hex 32)
KEYSTATIC_SECRET=

# Break-glass password for /keystatic. Passkeys are the normal way in; this is
# the recovery path if every enrolled device is lost. Keep it set, keep it long
# and random, store it in a password manager.
KEYSTATIC_AUTH_PASSWORD=

# Signs the /keystatic session cookie (generate with: openssl rand -hex 32).
# REQUIRED — without it /keystatic returns 503 for everyone.
# Rotating this value is the session kill switch: every outstanding login dies
# on the next request.
KEYSTATIC_SESSION_SECRET=

# Recovery token for enrolling a passkey when you cannot already unlock with one
# (generate with: openssl rand -hex 32). Sent as the x-enroll-token header.
# Once any passkey exists, the password alone can NO LONGER enroll a new device
# — only an existing passkey or this token can. Set it temporarily if every
# device is lost, then delete it again.
KEYSTATIC_ENROLL_TOKEN=

# Where /keystatic security alerts go (new passkey enrolled, passkey removed,
# break-glass password used). Falls back to WHISPER_TO_EMAIL. Needs RESEND_API_KEY.
KEYSTATIC_ALERT_EMAIL=

# Rollout/rollback switch. Unset (or anything other than 'passkey') keeps the
# old HTTP Basic Auth prompt. Set to 'passkey' only after enrolling at least two
# devices and setting KEYSTATIC_SESSION_SECRET — otherwise /keystatic 503s.
KEYSTATIC_AUTH_MODE=

# Optional WebAuthn relying-party id override. Defaults to the site host from site.config.mjs in prod.
KEYSTATIC_RP_ID=

# Upstash Redis (rate limiting + whisper dedup)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Whisper anti-abuse
WHISPER_TOKEN_SECRET=

# Question bank for the /whisper gate. A JSON array of
# [{"id":"...","question":"...","answers":["...","..."]}] — `id` is opaque and
# stable, `answers` is a non-empty list of accepted strings (the submitted answer
# is trimmed, lowercased, and has runs of whitespace collapsed before comparing).
# Kept in an env var, never in the repo, because
# the answers are personal data; that is what makes this repo safe to publish.
# There is no fallback bank on purpose: if this is unset, unparseable, has a
# malformed entry, or has duplicate ids, the whole bank is discarded and
# /api/whisper fails closed with 503. Fail-closed beats a publicly-known gate.
WHISPER_QUIZ=
# Separate private R2 bucket for whisper messages. Required — /api/whisper returns 503 without it.
WHISPER_BUCKET_NAME=

# Vercel API access. Not read by the app or the build — these belong in GitHub
# Actions secrets, not in a local .env. VERCEL_TOKEN and VERCEL_PROJECT_ID are
# used by setup-env.yml (pushes env vars, redeploys) and health.yml (reads the
# latest production deployment); VERCEL_ORG_ID is used by setup-env.yml only.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# Cloudflare R2 storage (used for image uploads and whisper messages)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Private backup bucket for daily backups. MUST differ from R2_BUCKET_NAME — backups
# contain unpublished drafts, putting them in the public bucket publishes them.
# GitHub Actions (backup.yml) only, so set in repo secrets, not .env.local.
R2_BACKUP_BUCKET_NAME=

# Upload endpoint secret (shared key to authenticate image upload requests)
UPLOAD_SECRET=

# Resend (transactional email for whisper notifications)
RESEND_API_KEY=

# Proxycheck.io (spam/proxy detection for whisper submissions)
PROXYCHECK_API_KEY=

# Email address whisper messages are forwarded to
WHISPER_TO_EMAIL=

# Keystatic GitHub App slug (for the GitHub App-based auth flow)
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# PostHog (optional). Project token is a public write-only key; the client only
# initialises in production builds and proxies through /ingest. Leave empty to
# ship without analytics.
NEXT_PUBLIC_POSTHOG_KEY=
