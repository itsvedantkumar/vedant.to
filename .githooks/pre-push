#!/usr/bin/env bash
# Local gate, same checks ci.yml runs. Installed by `npm install` through the
# "prepare" script (core.hooksPath = .githooks). Skip once with
# `git push --no-verify` when you know why.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

log=$(mktemp)
trap 'rm -f "$log"' EXIT

# Quiet on success, full output on failure.
step() {
  local name=$1
  shift
  echo "pre-push: $name"
  if ! "$@" >"$log" 2>&1; then
    cat "$log"
    echo "pre-push: $name failed"
    exit 1
  fi
}

step "npm run check (typecheck, content audit, identity, tests)" npm run --silent check
step "prettier --check" npx --no-install prettier --check .
step "eslint" npx --no-install eslint .

# Security scanners are optional locally; each one that is installed runs.
if command -v gitleaks >/dev/null; then
  # Only the commits about to leave: full history takes minutes.
  base=$(git rev-parse --verify --quiet '@{upstream}' || git rev-parse --verify --quiet origin/main || echo "HEAD~20")
  step "gitleaks ($base..HEAD)" gitleaks git --no-banner --redact --config .gitleaks.toml --log-opts "$base..HEAD" .
fi
if command -v osv-scanner >/dev/null; then
  step "osv-scanner" osv-scanner scan --lockfile package-lock.json
fi
if command -v zizmor >/dev/null; then
  step "zizmor" zizmor --no-progress --offline .github/workflows
fi
echo "pre-push: ok"
