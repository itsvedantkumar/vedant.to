root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Trailing whitespace is significant in Markdown/Markdoc (two spaces = hard line
# break). All prose content in this repo is .mdoc.
[*.{md,mdoc}]
trim_trailing_whitespace = false
