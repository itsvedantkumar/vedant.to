{
  "name": "vedant-to",
  "private": true,
  "version": "1.0.0",
  "description": "Personal site and blog",
  "license": "MIT",
  "author": "Vedant Kumar",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "tsc --noEmit && node scripts/audit-content.mjs && node scripts/check-identity.mjs && npm test",
    "check:identity": "node scripts/check-identity.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./tests/alias-loader.mjs --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix-images": "node scripts/normalize-images.mjs",
    "fix-content": "node scripts/normalize-content.mjs",
    "audit:content:watch": "node scripts/audit-content.mjs --watch",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.4",
    "posthog-js": "^1.425.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.25.0",
    "sugar-high": "^2.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@posthog/nextjs-config": "1.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-security": "^4.0.1",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": {
      ".": "^8.5.26",
      "nanoid": "^3.3.18"
    },
    "@toeverything/y-indexeddb": {
      "nanoid": "^5.1.16"
    }
  }
}
