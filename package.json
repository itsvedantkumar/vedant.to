{
  "name": "vedant-to",
  "private": true,
  "version": "1.0.0",
  "description": "Personal site and blog",
  "license": "MIT",
  "author": "Vedant Kumar",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/audit-content.mjs && npm test",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./tests/alias-loader.mjs --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix-images": "node scripts/normalize-images.mjs",
    "fix-content": "node scripts/normalize-content.mjs",
    "audit:content:watch": "node scripts/audit-content.mjs --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.25.0",
    "sugar-high": "^0.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": {
      ".": "^8.5.26",
      "nanoid": "^3.3.18"
    },
    "@toeverything/y-indexeddb": {
      "nanoid": "^5.1.16"
    }
  }
}
