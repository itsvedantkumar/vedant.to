{
  "name": "vedant-blog",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/audit-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix-images": "node scripts/normalize-images.mjs",
    "fix-content": "node scripts/normalize-content.mjs",
    "audit": "node scripts/audit-content.mjs",
    "audit:watch": "node scripts/audit-content.mjs --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@keystatic/core": "^0.5.38",
    "@keystatic/next": "^5.0.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/og": "^0.11.1",
    "next": "^15.5.0",
    "react": "18.3",
    "react-dom": "18.3",
    "resend": "^6.12.4",
    "sugar-high": "^0.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "postcss": "^8.5.10",
    "postcss-load-config": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "prettier": "^3.8.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
