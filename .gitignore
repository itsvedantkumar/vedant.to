# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
.turbo

# production
/build

# misc
.DS_Store
*.pem
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files: ignore every .env variant, commit only .env.example
.env
.env.local
.env*.local
.env.development
.env.production

# vercel
.vercel

# claude code (local only; IDE config, machine paths, and AI session logs shouldn't be in public repos)
.claude/worktrees/
.claude/launch.json
.claude/settings.local.json
.claude/context/
# local scan output (/security, ZAP, nuclei)
.audit/
.context

# typescript
*.tsbuildinfo
next-env.d.ts
content/posts/zz-test-fixture-*.mdoc

# Cloudflare Worker (ops/worker): generated config and local secrets
.wrangler/
ops/worker/wrangler.generated.jsonc
ops/worker/.dev.vars
