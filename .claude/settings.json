{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(export PATH*npm run build*)",
      "Bash(mdfind -name *)",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__list_connected_browsers"
    ]
  },
  "model": "claude-opus-5[1m]",
  "effortLevel": "high",
  "fastMode": true,
  "skillListingMaxDescChars": 200,
  "skillListingBudgetFraction": 0.016,
  "skillOverrides": {
    "xlsx": "off",
    "docx": "off",
    "pptx": "off",
    "build-mcp-server": "off",
    "dataviz": "name-only",
    "pdf": "name-only",
    "skill-creator": "name-only",
    "update-config": "name-only",
    "keybindings-help": "name-only",
    "fewer-permission-prompts": "name-only",
    "claude-in-chrome": "name-only",
    "init": "name-only",
    "loop": "name-only",
    "schedule": "name-only",
    "run": "name-only",
    "simplify": "name-only",
    "security-review": "name-only"
  },
  "precomputeCompactionEnabled": true,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": true,
  "showTurnDuration": true,
  "switchModelsOnFlag": true,
  "cleanupPeriodDays": 14,
  "enableWorkflows": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "BASH_MAX_OUTPUT_LENGTH": "50000",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "MCP_TIMEOUT": "10000",
    "MCP_TOOL_TIMEOUT": "60000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-session-context.sh\"",
            "statusMessage": "context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "statusMessage": "format"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-counter.sh\"",
            "statusMessage": "dispatch count"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-mandate.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/goal-gate.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/failure-diagnose.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-session-context.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.sh\"",
            "statusMessage": "guard"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\"",
    "padding": 0,
    "refreshInterval": 3
  },
  "forceLoginMethod": "claudeai",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
